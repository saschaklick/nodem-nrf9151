/*
 * spi3 (arduino_spi, enabled by default on this board) would claim
 * P0.11-P0.13 - disabled so those pins stay free for the HUB75 lines.
 * The DK's external flash still sits on them (CS = P0.20, flash node is
 * disabled in the base board dts).
 */
&spi3 {
	status = "disabled";
};

/* ...so hold the flash's CS high, or it could answer on P0.12 while the
 * HUB75 lines on P0.11-P0.13 are switching (see hub75_task.h). */
&gpio0 {
	flash-cs-hog {
		gpio-hog;
		gpios = <20 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "flash-cs";
	};
};

/* P0.00 (pwm_led0, LED1) is HUB75's R1 - nothing uses pwm0, and a second
 * PWM instance claiming the same pin would fight hub75_task's. LED1 stays
 * main.c's heartbeat, as a plain GPIO (led0). */
&pwm0 {
	status = "disabled";
};

/* SSD1306 OLED on the board's arduino_i2c bus: P0.30 (SDA) / P0.31 (SCL),
 * Arduino D14/D15 - pinctrl and clock-frequency (I2C_BITRATE_FAST) already
 * come from the base board dts. No `ssd1306` child node here -
 * display_task.c talks to the panel directly over this bus with its own
 * hand-rolled driver. */
&i2c2 {
	status = "okay";
};

/* P0.28 (RX) / P0.29 (TX) - disabled by default on the `_ns` target ("used
 * by default in TF-M" per the base board dts), otherwise free. Pinctrl and
 * current-speed (115200) are already set correctly at the common board
 * level; this just re-enables it. Dedicated to console/log output only
 * (see log.h/prj.conf) - the `chosen` override below moves it here from
 * uart0, which is now dedicated to the process_command protocol instead
 * (see uart_task.c), so log text can never corrupt that protocol's framing
 * either way. */
&uart1 {
	status = "okay";
};

/ {
	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
	};
};
